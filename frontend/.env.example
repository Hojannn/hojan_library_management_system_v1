# Base URL of the Flask backend API (no trailing slash).
# Defaults to http://127.0.0.1:5000/api when unset.
VITE_API_BASE_URL=http://127.0.0.1:5000/api

# Firebase web client config, used by @react-oauth/google.
VITE_GOOGLE_CLIENT_ID=

# NOTE: every VITE_* variable is inlined into the client bundle at build time and
# is therefore PUBLIC. Never put a server-side secret here. The Google OAuth
# *client secret* is only needed by the backend and belongs in backend/.env
# (see backend/.env.example); the browser only ever needs the client ID.